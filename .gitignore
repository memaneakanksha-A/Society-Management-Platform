# Dependencies
node_modules/

# Environment files (passwords, DB string, JWT secret)
.env
.env.*
!.env.example

# Build output
dist/
build/
*.tsbuildinfo

# Uploaded files (tenant Aadhaar, agreements, photos)
Backend/uploads/*
!Backend/uploads/.gitkeep

# Private tenant documents (Aadhaar, agreements, police verification)
Backend/private-uploads/*
!Backend/private-uploads/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.swp

# Test / cache
coverage/
.cache/
.eslintcache
.vite/

# Misc
*.local